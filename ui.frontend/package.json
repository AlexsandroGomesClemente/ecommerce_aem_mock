{
  "name": "ecommerce-aem-vue-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Front-end Vue 3 + TypeScript + Pinia integrado ao AEM ClientLibs (ADR-004) e GraphQL BFF (ADR-003)",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build && node scripts/aem-clientlib-generator.mjs",
    "preview": "vite preview --port 4173",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.14.10",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}

